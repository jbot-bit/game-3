extends GutTest
const Abilities=preload("res://game/survival/ability_rules.gd")
const Lights=preload("res://game/survival/light_rules.gd")
const Choice=preload("res://game/crew/crew_choice.gd")
const Expedition=preload("res://game/expedition/expedition_rules.gd")
const Hunter=preload("res://game/survival/hunter_rules.gd")
const Events=preload("res://game/expedition/director.gd")

func test_light_choice_and_shared_slowdown():
	var l=Lights.new()
	assert_true(l.set_reserve("reeds").ok)
	assert_true(l.station_powered("jetty",239.9))
	assert_false(l.station_powered("jetty",240.0))
	assert_true(l.station_powered("reeds",629.9))
	assert_false(l.set_reserve("jetty").ok)
	assert_true(l.handheld_effect("hunter",10.0).ok)
	assert_false(l.handheld_effect("hunter",13.0).ok)
	assert_true(l.handheld_effect("hunter",18.0).ok)
	assert_eq(l.drain("a","flood",true,45.0).remaining,45.0)
	assert_eq(l.drain("b","surveyor",true,45.0).remaining,0.0)
	l.recharge("b","surveyor")
	assert_eq(l.drain("b","surveyor",false,20.0).remaining,45.0)

func test_roles_cooldown_and_nonstacking_keeper():
	var a=Abilities.new()
	assert_true(a.use("a","scout",{},0).ok)
	assert_false(a.use("a","scout",{},29.9).ok)
	assert_true(a.use("a","scout",{},30).ok)
	assert_true(a.use("b","keeper",{},0).ok)
	assert_false(a.use("c","keeper",{},3.9).ok)
	assert_true(a.use("c","keeper",{},4.0).ok)
	assert_false(a.use("d","rigger",{"valid_path":false,"distance":3.0},0).ok)
	assert_true(a.use("d","rigger",{"valid_path":true,"distance":5.0},0).ok)

func test_vote_majority_disconnect_and_fallback():
	var c=Choice.new()
	c.open(["crew_1","crew_2","crew_3"],150.0)
	assert_eq(c.vote("crew_1","reeds",151).code,"pending")
	assert_false(c.vote("crew_1","jetty",151.5).ok)
	assert_eq(c.vote("crew_2","reeds",152).get("committed_station",""),"reeds")
	assert_eq(c.vote("crew_3","jetty",153).code,"already_committed")
	c=Choice.new()
	c.open(["a","b"],150.0)
	c.vote("a","reeds",151)
	c.roster_changed(["a"])
	assert_false(c.snapshot().open)
	c.open(["a"],155)
	assert_eq(c.vote("a","reeds",156).get("committed_station",""),"reeds")
	c=Choice.new()
	c.open(["a","b"],150)
	c.tick(165)
	assert_false(c.snapshot().open)
	assert_eq(c.tick(180).get("committed_station",""),"jetty")
	assert_false(c.tick(181).has("committed_station"))

func test_pause_revive_and_return_windows():
	var r=Expedition.new()
	r.start("x",["a","b","c"])
	r.advance(200)
	assert_eq(r.phase,"dusk")
	r.down("b")
	r.set_paused(true)
	r.advance(60)
	assert_eq(r.elapsed_s,200.0)
	assert_true(r.players.b.downed)
	r.set_paused(false)
	assert_false(r.revive("a","b",2.9).ok)
	assert_true(r.revive("a","b",3.0).ok)
	assert_false(r.down("b").ok)
	r.advance(3.1)
	r.down("b")
	assert_has(r.advance(25).returned,"b")
	assert_false(r.players.b.downed)

func test_reopening_ballot_preserves_other_crews_votes():
	var c=Choice.new()
	c.open(["a","b","c"],100)
	c.vote("a","reeds",101)
	assert_false(c.open(["a","b","c"],102).ok)
	assert_eq(c.vote("b","reeds",103).get("committed_station",""),"reeds")

func test_terminal_exactly_once_and_ready_departure():
	var r=Expedition.new()
	r.start("x",["a","b"])
	r.advance(630)
	assert_true(r.terminal)
	assert_ne(r.advance(1).code,"settle")
	r=Expedition.new()
	r.start("x",["a","b"])
	r.set_aboard("a",true)
	r.set_ready("a",true)
	r.disconnect_profile("b")
	assert_eq(r.advance(0.1).code,"depart")
	assert_eq(r.advance(20).code,"settle")

func test_hunter_warning_recovery_and_host_event_budget():
	var h=Hunter.new()
	assert_false(h.advance(0.1,{"night":true,"target_visible":true}).can_attack)
	assert_false(h.advance(1.9,{"night":true,"target_visible":true}).can_attack)
	assert_true(h.advance(0.2,{"night":true,"target_visible":true}).can_attack)
	h.advance(20,{"night":true,"target_visible":true})
	assert_eq(h.state,"recover")
	assert_false(h.advance(19.9,{"night":true,"target_visible":true}).can_attack)
	var e=Events.new()
	assert_false(e.request("fog",0,{"is_host":false}).ok)
	assert_true(e.request("fog",0,{"is_host":true}).ok)
	assert_false(e.request("sighting",1,{"is_host":true}).ok)
	assert_eq(e.tick(15,{}).active,"")
	assert_false(e.request("sighting",46,{"is_host":true,"rescuing":true}).ok)
	assert_true(e.request("clear_event",2,{"is_host":true}).ok)
